{
  "packages": {
    "xovi": {
      "maintenanceCommands": [
        {
          "id": "start",
          "label": "Start UI with Mods",
          "description": "Start or restart xovi",
          "command": "/home/root/xovi/start",
          "requiresTerminal": true,
          "allowStop": false
        },
        {
          "id": "stock",
          "label": "Start UI without Mods",
          "description": "Restart interface without mods applied",
          "command": "/home/root/xovi/stock",
          "requiresTerminal": true,
          "allowStop": false
        },
        {
          "id": "debug",
          "label": "Debug",
          "description": "Run xovi in debug mode for troubleshooting issues",
          "command": "/home/root/xovi/debug",
          "requiresTerminal": true,
          "allowStop": true
        }
      ]
    },
    "qt-resource-rebuilder": {
      "hooks": {
        "postInstall": "rebuild_hashtable_dialog"
      },
      "maintenanceCommands": [
        {
          "id": "rebuild_hashtable",
          "label": "Rebuild Hashtable",
          "description": "Rebuild Qt hashtable (required after OS upgrades)",
          "command": "/home/root/xovi/rebuild_hashtable",
          "requiresTerminal": false,
          "allowStop": false,
          "hook": "rebuild_hashtable_dialog"
        }
      ]
    },
    "launcherctl": {
      "maintenanceCommands": [
        {
          "id": "start-launcher",
          "label": "Start",
          "description": "Start the current launcher",
          "command": "/home/root/.vellum/bin/launcherctl start-launcher"
        },
        {
          "id": "restart-launcher",
          "label": "Restart",
          "description": "Restart the current launcher",
          "command": "/home/root/.vellum/bin/launcherctl restart-launcher"
        },
        {
          "id": "stop-launcher",
          "label": "Stop",
          "description": "Stop the active launcher",
          "command": "/home/root/.vellum/bin/launcherctl stop-launcher"
        },
        {
          "id": "choose-launcher",
          "label": "Switch",
          "description": "Pick which launcher starts on your reMarkable",
          "command": "",
          "hook": "launcher_select"
        },
        {
          "id": "launcher-status",
          "label": "Status",
          "description": "Show the current launcher and its running apps",
          "command": "/home/root/.vellum/bin/launcherctl status"
        }
      ]
    },
    "klaus-remarkable": {
      "maintenanceCommands": [
        {
          "id": "show-pairing-details",
          "label": "Show pairing details",
          "description": "Display the tablet address, username, and Klaus pairing password",
          "command": "/home/root/.vellum/bin/klaus-remarkable-pairing",
          "requiresTerminal": false,
          "allowStop": false
        }
      ]
    }
  },
  "virtuals": {
    "launcher": {
      "default": "appload"
    }
  }
}
