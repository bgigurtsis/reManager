{
  "packages": {
    "xovi": {
      "maintenanceCommands": [
        {
          "id": "start",
          "label": "Start",
          "description": "Start xovi with the stock interface",
          "command": "/home/root/xovi/start",
          "requiresTerminal": true,
          "allowStop": false
        },
        {
          "id": "stock",
          "label": "Stock",
          "description": "Restart with stock xochitl interface",
          "command": "/home/root/xovi/stock",
          "requiresTerminal": true,
          "allowStop": false
        },
        {
          "id": "debug",
          "label": "Debug",
          "description": "Run xovi in debug mode with console output",
          "command": "/home/root/xovi/debug",
          "requiresTerminal": true,
          "allowStop": true
        }
      ]
    },
    "qt-resource-rebuilder": {
      "hooks": {
        "postInstall": "rebuild_hashtable_dialog"
      },
      "maintenanceCommands": [
        {
          "id": "rebuild_hashtable",
          "label": "Rebuild Hashtable",
          "description": "Rebuild the Qt resource hashtable",
          "command": "/home/root/xovi/rebuild_hashtable",
          "requiresTerminal": false,
          "allowStop": false,
          "hook": "rebuild_hashtable_dialog"
        }
      ]
    }
  }
}
